generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id                       String            @id @default(uuid()) @db.Uuid
  email                    String            @unique
  password                 String
  name                     String
  role                     Role              @default(USER)
  avatarUrl                String?
  resetPasswordToken       String?
  resetPasswordExpires     DateTime?
  books                    Book[]
  sentExchangeRequests     ExchangeRequest[] @relation("SentExchangeRequests")
  receivedExchangeRequests ExchangeRequest[] @relation("ReceivedExchangeRequests")

  @@index([resetPasswordToken])
  @@map("users")
}

model Book {
  id               String            @id @default(uuid()) @db.Uuid
  name             String
  author           String
  photoUrl         String?
  userId           String            @db.Uuid
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  exchangeRequests ExchangeRequest[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([userId])
  @@index([name])
  @@map("books")
}

model ExchangeRequest {
  id          String   @id @default(uuid()) @db.Uuid
  requesterId String   @db.Uuid
  requester   User     @relation("SentExchangeRequests", fields: [requesterId], references: [id], onDelete: Cascade)
  ownerId     String   @db.Uuid
  owner       User     @relation("ReceivedExchangeRequests", fields: [ownerId], references: [id], onDelete: Cascade)
  bookId      String   @db.Uuid
  book        Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([ownerId])
  @@index([requesterId])
  @@index([bookId])
  @@map("exchange_requests")
}
